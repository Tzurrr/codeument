{
  "type": "object",
  "additionalProperties": false,
  "required": [
    "title", "summary", "intent", "doc_kind", "steps", "commands",
    "affected_systems", "files_touched", "tags", "suggested_location",
    "related_doc_id", "confidence", "open_questions"
  ],
  "properties": {
    "title": { "type": "string", "description": "Short, specific page title in the style of a runbook or changelog entry." },
    "summary": { "type": "string", "description": "Two to five sentences describing what was done and the outcome, past tense." },
    "intent": { "type": "string", "description": "Why the work was done, as far as the evidence shows. Say 'unclear' if it is not evident." },
    "doc_kind": { "type": "string", "enum": ["runbook", "howto", "changelog", "incident", "note"] },
    "steps": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["description", "commands", "notes"],
        "properties": {
          "description": { "type": "string" },
          "commands": { "type": "array", "items": { "type": "string" } },
          "notes": { "type": "string" }
        }
      }
    },
    "commands": { "type": "array", "items": { "type": "string" }, "description": "The commands worth keeping, deduplicated, in order." },
    "affected_systems": { "type": "array", "items": { "type": "string" } },
    "files_touched": { "type": "array", "items": { "type": "string" } },
    "tags": { "type": "array", "items": { "type": "string" } },
    "suggested_location": {
      "type": "object",
      "additionalProperties": false,
      "required": ["space", "parent_path", "page_title"],
      "properties": {
        "space": { "type": "string" },
        "parent_path": { "type": "array", "items": { "type": "string" } },
        "page_title": { "type": "string" }
      }
    },
    "related_doc_id": { "type": "string", "description": "Id of an existing document this should be appended to, or empty string." },
    "confidence": { "type": "string", "enum": ["low", "medium", "high"] },
    "open_questions": { "type": "array", "items": { "type": "string" } }
  }
}
