{{- end}}
{{- if .GitDiffStat}}
## Git diff stat (file names and line counts only)
{{.GitDiffStat}}
{{- end}}
{{- if .RecentDocs}}
## Recent documents from this host (id: title)
{{range .RecentDocs}}- {{.ID}}: {{.Title}}
{{end}}
{{- end}}
